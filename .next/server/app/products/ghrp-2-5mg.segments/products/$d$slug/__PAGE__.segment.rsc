c:["$","section",null,{"className":"border-t border-[var(--border)]","children":["$","div",null,{"className":"mx-auto max-w-6xl px-6 py-16 grid gap-12 md:grid-cols-[3fr_2fr]","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--accent)] mb-3","children":"Description"}],["$","h2",null,{"className":"text-[28px] font-semibold tracking-tight text-[var(--text)] mb-6","children":["GHRP-2"," research register"]}],["$","div",null,{"className":"space-y-5 text-[15px] leading-[1.7] text-[var(--text-muted)]","children":[["$","p","0",{"className":"text-[var(--text)] text-[16px]","children":"GHRP-2 is a synthetic hexapeptide (D-Ala-D-2-Nal-Ala-Trp-D-Phe-Lys-NH2) of the growth-hormone-releasing-peptide class. It is one of the most extensively characterized GH secretagogues in the published research literature and serves as a research reference for investigating ghrelin-receptor (GHS-R1a) pathway activation and the resulting somatotroph response."}],["$","p","1",{"children":"In vitro studies in pituitary cell cultures document concentration-dependent GH-secretion responses to GHRP-2 exposure. Receptor-binding assays in cell lines transfected with the GHS-R1a confirm direct receptor engagement; patch-clamp recordings document the membrane-electrophysiology response. Cell-culture work also documents synergistic interaction between GHRP-2 and GHRH analogs, with combined exposures producing GH-secretion responses larger than either compound alone."}],["$","p","2",{"children":"Animal-model research, primarily in rodents, characterizes GH-pulse profiles, integration with endogenous GHRH and somatostatin signaling, and downstream IGF-1 axis effects in chronic-administration paradigms. Published studies employ 1-100 mcg/kg body weight ranges across acute and chronic protocols."}],["$","p","3",{"children":"GHRP-2 is supplied as a lyophilized pharmaceutical-grade research reference. The 5mg vial is reconstituted in sterile bacteriostatic saline or distilled water per protocol. Storage at 2-8 degrees Celsius in sealed vials. For in-vitro research, cell-culture, and animal-model investigation only. No human administration. Not approved by any regulatory authority for any indication."}]]}]]}],["$","aside",null,{"className":"md:sticky md:top-24 md:self-start","children":[["$","p",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--accent)] mb-3","children":"Specifications"}],["$","div",null,{"className":"bg-[var(--surface)] border border-[var(--border)] rounded-[14px] shadow-[var(--shadow-sm)] p-6","children":["$","dl",null,{"className":"w-full","children":[["$","div","SKU-0",{"className":"flex items-baseline justify-between gap-4 py-2 border-b border-dotted border-[var(--border)] last:border-b-0","children":[["$","dt",null,{"className":"font-mono uppercase tracking-[0.12em] text-[var(--text-muted)] text-[12px]","children":"SKU"}],["$","dd",null,{"className":"font-mono text-[var(--text)] tabular-nums text-right text-[14px]","children":"GHRP-2-5MG"}]]}],["$","div","Format-1",{"className":"flex items-baseline justify-between gap-4 py-2 border-b border-dotted border-[var(--border)] last:border-b-0","children":[["$","dt",null,{"className":"font-mono uppercase tracking-[0.12em] text-[var(--text-muted)] text-[12px]","children":"Format"}],["$","dd",null,{"className":"font-mono text-[var(--text)] tabular-nums text-right text-[14px]","children":"Lyophilized vial"}]]}],["$","div","Dose-2",{"className":"flex items-baseline justify-between gap-4 py-2 border-b border-dotted border-[var(--border)] last:border-b-0","children":["$L21","$L22"]}],"$L23","$L24","$L25","$L26","$L27"]}]}],"$L28"]}]]}]}]
