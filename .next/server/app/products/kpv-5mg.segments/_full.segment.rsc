arch reference. The 5mg vial is reconstituted in sterile bacteriostatic saline or distilled water per protocol. Storage at 2-8 degrees Celsius in sealed vials. For in-vitro research, cell-culture, and animal-model investigation only. No human administration. Not approved by any regulatory authority for any indication."}]]}]]}],["$","aside",null,{"className":"md:sticky md:top-24 md:self-start","children":[["$","p",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--accent)] mb-3","children":"Specifications"}],["$","div",null,{"ref":"$undefined","className":"bg-[var(--surface)] border border-[var(--border)] rounded-[14px] shadow-[var(--shadow-sm)] p-6","children":["$","dl",null,{"ref":"$undefined","className":"w-full","children":[["$","div","SKU-0",{"className":"flex items-baseline justify-between gap-4 py-2 border-b border-dotted border-[var(--border)] last:border-b-0","children":[["$","dt",null,{"className":"font-mono uppercase tracking-[0.12em] text-[var(--text-muted)] text-[12px]","children":"SKU"}],["$","dd",null,{"className":"font-mono text-[var(--text)] tabular-nums text-right text-[14px]","children":"KPV-5MG"}]]}],["$","div","Format-1",{"className":"flex items-baseline justify-between gap-4 py-2 border-b border-dotted border-[var(--border)] last:border-b-0","children":[["$","dt",null,{"className":"font-mono uppercase tracking-[0.12em] text-[var(--text-muted)] text-[12px]","children":"Format"}],["$","dd",null,{"className":"font-mono text-[var(--text)] tabular-nums text-right text-[14px]","children":"Lyophilized vial"}]]}],["$","div","Dose-2",{"className":"flex items-baseline justify-between gap-4 py-2 border-b border-dotted border-[var(--border)] last:border-b-0","children":["$L3a","$L3b"]}],"$L3c","$L3d","$L3e","$L3f","$L40"]}]}],"$L41"]}]]}]}]
