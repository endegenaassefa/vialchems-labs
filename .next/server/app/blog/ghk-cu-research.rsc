ides"}],["$","$L6","/coa",{"href":"/coa","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"Verify a Vial"}],["$","$L6","/verify",{"href":"/verify","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"Get Verified"}],["$","$L6","/account",{"href":"/account","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"My Lab"}]]}],["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L7",null,{}],["$","$L8",null,{}],["$","$L6",null,{"href":"/verify","className":"hidden md:inline-flex items-center px-3 h-9 rounded-[var(--radius-md)] bg-[var(--accent)] text-[var(--text-on-accent)] text-[13px] font-medium hover:bg-[var(--accent-deep)] transition-colors duration-[var(--dur-short)]","children":"Get Verified"}],["$","$L6",null,{"href":"/cart","className":"inline-flex items-center gap-2 px-3 h-9 rounded-[var(--radius-md)] border border-[var(--border)] hover:border-[var(--accent)] text-[13px] transition-colors duration-[var(--dur-short)]","aria-label":"Cart","children":[["$","span",null,{"children":"Cart"}],["$","$L9",null,{}]]}],["$","$La",null,{"items":"$0:f:0:1:0:props:children:1:props:children:1:props:children:1:props:notFound:0:0:props:children:props:children:2:props:children:4:props:items"}]]}]]}]}],["$","main",null,{"id":"main","className":"flex-1","children":["$","article",null,{"className":"border-b border-[var(--border)]","children":["$","div",null,{"className":"mx-auto max-w-3xl px-6 py-20 md:py-24","children":[["$","p",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--accent)] mb-6","children":["$","$L6",null,{"href":"/blog","className":"hover:text-[var(--accent-soft)]","