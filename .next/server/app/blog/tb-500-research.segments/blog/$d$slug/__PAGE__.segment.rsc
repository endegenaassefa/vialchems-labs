0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"TB-500 (Thymosin Beta-4): A Mechanism Research Register\",\"description\":\"TB-500 is the synthetic 17-amino-acid C-terminal actin-binding fragment of thymosin beta-4. Research register: discovery, sequence, in-vitro actin polymerization mechanism, cell-migration scratch-assay literature, and animal-model angiogenesis observations.\",\"datePublished\":\"2026-05-06\",\"author\":{\"@type\":\"Organization\",\"name\":\"vialchemlabs Research\"},\"mainEntityOfPage\":\"https://vialchemlabs.com/blog/tb-500-research\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://vialchemlabs.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Research Index\",\"item\":\"https://vialchemlabs.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"TB-500 (Thymosin Beta-4): A Mechanism Research Register\",\"item\":\"https://vialchemlabs.com/blog/tb-500-research\"}]}"}}],["$","header",null,{"className":"border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-md sticky top-0 z-20","children":["$","div",null,{"className":"mx-auto max-w-6xl px-6 h-16 flex items-center justify-between","children":[["$","$L2",null,{"href":"/","className":"group inline-flex items-baseline leading-none","aria-label":"vialchemlabs home","children":["$","span",null,{"className":"text-[18px] font-medium tracking-tight text-[var(--text)]","children":"vialchemlabs"}]}],["$","nav",null,{"className":"hidden md:flex items-center gap-1","aria-label":"Primary","children":[["$","$L2","/shop",{"href":"/shop","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"Shop Peptides"}],["$","$L2","/coa",{"href":"/coa","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"Verify a Vial"}],["$","$L2","/verify",{"href":"/verify","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"Get Verified"}],["$","$L2","/account",{"href":"/account","className":"px-3 py-2 text-[14px] text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-[var(--dur-short)] rounded-[var(--radius-md)]","children":"My Lab"}]]}],["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L3",null,{}],["$","$L4",null,{}],["$","$L2",null,{"href":"/verify","className":"hidden md:inline-flex items-center px-3 h-9 rounded-[var(--radius-md)] bg-[var(--accent)] text-[var(--text-on-accent)] text-[13px] font-medium hover:bg-[var(--accent-deep)] transition-colors duration-[var(--dur-short)]","children":"Get Verified"}],["$","$L2",null,{"href":"/cart","className":"inline-flex items-center gap-2 px-3 h-9 rounded-[var(--radius-md)] border border-[var(--border)] hover:border-[var(--accent)] text-[13px] transition-colors duration-[var(--dur-short)]","aria-label":"Cart","children":[["$","span",null,{"children":"Cart"}],["$","$L5",null,{}]]}],["$","$L6",null,{"items":[{"href":"/shop","label":"Shop Peptides"},{"href":"/coa","label":"Verify a Vial"},{"href":"/verify","label":"Get Verified"},{"href":"/account","label":"My Lab"}]}]]}]]}]}],["$","main",null,{"id":"main","className":"flex-1","children":["$","article",null,{"className":"border-b border-[var(--border)]","children":["$","div",null,{"className":"mx-auto max-w-3xl px-6 py-20 md:py-24","children":[["$","p",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--accent)] mb-6