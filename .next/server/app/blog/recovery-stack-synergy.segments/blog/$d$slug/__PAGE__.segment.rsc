hover:text-[var(--accent)] transition-colors","children":"Certificate of Analysis"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/test-reports","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Lab Partner"}]}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-muted)] mb-3","children":"Customer Service"}],["$","ul",null,{"className":"space-y-2 text-[14px]","children":[["$","li",null,{"children":["$","$L2",null,{"href":"/contact","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Contact"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/faq","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"FAQ"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/account","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Account"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/affiliate","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Affiliate Program"}]}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-muted)] mb-3","children":"Legal"}],["$","ul",null,{"className":"space-y-2 text-[14px]","children":[["$","li",null,{"children":["$","$L2",null,{"href":"/legal/terms","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Terms"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/legal/privacy","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Privacy"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/legal/refunds","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Refunds"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/legal/shipping","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Shipping"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/legal/cookies","className":"text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors","children":"Cookies"}]}]]}]]}]]}],"$L1b","$L1c"]}]}]
f:["$","script","script-0",{"src":"/_next/static/chunks/167b7t3qbf~ly.js","async":true}]
