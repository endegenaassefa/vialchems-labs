1d:["$","p",null,{"className":"mb-4","children":"We do not store full payment-credential data on our servers. Crypto payments are processed via self-hosted infrastructure that records the transaction reference. Bank-transfer (ACH) payments are processed via Plaid, which discloses to us only a limited transaction reference sufficient for order reconciliation."}]
1e:["$","h3",null,{"className":"text-[18px] font-medium leading-tight text-[var(--text)] mt-7 mb-2","children":"1.3 Shipping Information"}]
1f:["$","p",null,{"className":"mb-4","children":"We collect the shipping address, recipient name, and contact phone number associated with each order, and we share the minimum necessary information with carriers (USPS, FedEx) to fulfill the order."}]
20:["$","h3",null,{"className":"text-[18px] font-medium leading-tight text-[var(--text)] mt-7 mb-2","children":"1.4 Behavioral and Technical Information"}]
21:["$","p",null,{"className":"mb-4","children":"Our hosting and analytics infrastructure record server-level technical information: IP address, device and browser identifiers, time of access, pages requested, referrer URL, and similar data. We use this for site operation, fraud prevention, and aggregated, de-identified analytics."}]
