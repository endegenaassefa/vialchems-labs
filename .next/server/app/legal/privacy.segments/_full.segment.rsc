33:["$","p",null,{"className":"mb-4","children":["California residents have additional rights under the CCPA: to know what categories of personal information are collected, to opt out of any \"sale\" (we do not sell personal data), and to request deletion. To exercise any of these rights, email"," ",["$","a",null,{"href":"mailto:research@vialchemlabs.com","className":"text-[var(--accent)] underline-offset-2 hover:text-[var(--accent-soft)] hover:underline transition-colors","children":"research@vialchemlabs.com"}],". We may verify your identity before responding. We will respond within the timeframe required by applicable law (typically 30 days)."]}]
34:["$","h2",null,{"className":"text-[22px] md:text-[26px] font-medium leading-tight text-[var(--text)] mt-12 mb-4","children":"7. Children"}]
35:["$","p",null,{"className":"mb-4","children":"We do not knowingly collect personal data from anyone under 21 years of age. The site and the products are not directed to or available to users under 21. If we learn that we have collected personal data from a person under 21, we will delete that data."}]
36:["$","h2",null,{"className":"text-[22px] md:text-[26px] font-medium leading-tight text-[var(--text)] mt-12 mb-4","children":"8. Security"}]
37:["$","p",null,{"className":"mb-4","children":"We use industry-standard technical and organizational measures to protect personal data, including encryption in transit (HTTPS), encryption at rest where supported by our database provider, access controls, audit logging, and least-privilege staff access. No system is perfectly secure; we cannot guarantee absolute security."}]
38:["$","h2",null,{"className":"text-[22px] md:text-[26px] font-medium leading-tight text-[var(--text)] mt-12 mb-4","children":"9. International Transfers"}]
39:["$","p",null,{"className":"mb-4","children":"Personal data may be processed in the United States. If you access the site from outside the United States, you understand that your data will be transferred to and processed in the United States."}]
