27:["$","p",null,{"className":"mb-4","children":"Lyophilized peptide vials are packaged with foam inserts and padded outer cartons calibrated for ambient transit. We do not include bacteriostatic water, syringes, alcohol pads, or any reconstitution ancillaries; researchers source these separately. Shipping cartons are plain and do not display product names."}]
28:["$","h2",null,{"className":"text-[22px] md:text-[26px] font-medium leading-tight text-[var(--text)] mt-12 mb-4","children":"7. Lost Packages"}]
29:["$","p",null,{"className":"mb-4","children":["For packages marked \"delivered\" that have not arrived, please first file a claim with USPS or FedEx using your tracking number, then contact ",["$","a",null,{"href":"mailto:research@vialchemlabs.com","className":"text-[var(--accent)] underline-offset-2 hover:text-[var(--accent-soft)] hover:underline transition-colors","children":"research@vialchemlabs.com"}]," ","with the order ID. ","vialchemlabs"," will independently investigate from the sender side and provide a replacement at our discretion based on available evidence. See the ",["$","a",null,{"href":"/legal/refunds","className":"text-[var(--accent)] underline-offset-2 hover:text-[var(--accent-soft)] hover:underline transition-colors","children":"Refund Policy"}]," ","for replacement criteria."]}]
