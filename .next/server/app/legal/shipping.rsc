21:["$","p",null,{"className":"mb-4","children":["Standard shipping is free on orders with a subtotal of $","200"," ","or more before tax and discounts. The threshold is applied automatically at checkout."]}]
22:["$","h2",null,{"className":"text-[22px] md:text-[26px] font-medium leading-tight text-[var(--text)] mt-12 mb-4","children":"4. Same-Business-Day Cutoff"}]
23:["$","p",null,{"className":"mb-4","children":"Orders placed before 3:00 pm Mountain Time on a business day (Monday through Friday, excluding US federal holidays) ship the same business day. Orders placed after the cutoff or on weekends or holidays ship the next business day. Order processing time may be extended during peak periods or weather delays; we will communicate any impact via order email."}]
