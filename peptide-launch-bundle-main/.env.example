# Peptide D2C Site — Environment Configuration Template
#
# Copy this file to .env (do NOT commit .env). Fill in your actual values.
# Phase numbers refer to the 15-phase build defined in corpus/SUPER_PROMPT_v3_2026-05-08.md.

# ============================================================
# Site basics (Phase 0, Phase 4)
# ============================================================
SITE_URL=https://numeruspeptides.com
BRAND_NAME=Numerus Labs
BRAND_DOMAIN=numeruspeptides.com

# ============================================================
# Supabase (Phase 3) — auth + database
# ============================================================
# Create new project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Payments (Phase 9)
# ============================================================
# stub for dev (deterministic mock); btcpay or plaid for prod
PAYMENT_PROVIDER=stub

# BTCPay Server (self-hosted)
# Operator provisions BTCPay in Docker per scripts/btcpay-setup.sh
BTCPAY_URL=https://your-btcpay-server.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# Plaid ACH
# Get credentials from https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions
PLAID_COUNTRY_CODES=US

# Stripe (Phase 2 placeholder; do NOT activate for Day 1)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================================
# Email (Phase 6, 10)
# ============================================================
# Get API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
ORDER_EMAIL_FROM=research@numeruspeptides.com
ORDER_STAFF_EMAILS=ops@numeruspeptides.com

# ============================================================
# Sentry monitoring (Phase 3, Phase 15)
# ============================================================
# Create project at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================
# Lab partner (Phase 7)
# ============================================================
# Janoshik Analytical recommended; confirm with source supplier
LAB_PARTNER_NAME=Janoshik Analytical
LAB_PARTNER_PORTAL_URL=https://janoshik.com

# ============================================================
# Shipping (Phase 7, Phase 10)
# ============================================================
# In cents; ~$15 baseline for US Priority
PILOT_US_SHIPPING_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=20000

# ============================================================
# Misc
# ============================================================
NODE_ENV=development
NEXT_PUBLIC_SITE_NAME=Numerus Labs
REQUIRE_SUPABASE=false
OPS_SIGNUP_ENABLED=false

# ============================================================
# LLC + legal entity (operator confirms post-formation)
# ============================================================
# Wyoming / Delaware / Nevada recommended
LLC_NAME=Numerus Labs LLC
LLC_JURISDICTION=Wyoming
LLC_REGISTERED_AGENT=
LLC_PRINCIPAL_ADDRESS=

# ============================================================
# Vercel (Phase 14)
# ============================================================
# Get from `vercel link` in your project directory
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=

# ============================================================
# Optional dev / debug flags
# ============================================================
# Set to true for verbose logging during build
DEBUG_BUILD=false
# Set to true to enable Phase 2 card payment integration (recommended: false until Day 90+)
ENABLE_CARDS_PHASE_2=false
