# Mogtrix environment template. Copy to .env.local for local dev.
# All NEXT_PUBLIC_* values are exposed to the browser bundle.

# Canonical site URL. Used by metadata, sitemap, and robots.
# Local: http://localhost:3000
# Prod:  https://mogtrix.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public browser config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer Supabase naming. Used only if the anon key is empty.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only service role key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Set true for pilot/prod so request intake fails closed instead of returning local-demo success.
REQUIRE_SUPABASE=false
# Set true on protected pilot deployments to allow staff account requests.
# New staff accounts remain inactive until promoted in public.profiles.
OPS_SIGNUP_ENABLED=false

# Hosted payment pilot.
# Local development may omit these and fall back to the stub adapter.
# Preview and production should fail closed when Stripe is selected but not configured.
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PILOT_US_SHIPPING_CENTS=1500

# Order email notifications.
ORDER_EMAIL_FROM=
ORDER_STAFF_EMAILS=
RESEND_API_KEY=

# Sentry error monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
