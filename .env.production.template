# =============================================================================
# v5.0.0 Production Environment Template (HIL GATE 1)
# =============================================================================
#
# This file lists every production environment variable required for the
# vialchemlabs.net deployment. The operator must provision each value via:
#   (a) The Vercel project environment-variables dashboard
#       (https://vercel.com/dashboard/projects/<id>/settings/environment-variables)
#   (b) OR a local .env.production file (gitignored; never committed)
#
# Provision then respond "credentials provisioned" or "credentials set in
# Vercel" to the v5 closure session, and Phase 12 (merge + deploy) resumes.
#
# Per Iron Law 2.22: no real credentials in committed source. This template
# is INTENTIONALLY without values — operator fills in via Vercel dashboard
# or local .env.production (gitignored).
#
# =============================================================================
# Vercel (deploy target)
# =============================================================================
# Provision via: https://vercel.com/dashboard/projects/<id>/settings/environment-variables
NEXT_PUBLIC_SITE_URL=https://vialchemlabs.net
SITE_URL=https://vialchemlabs.net
BRAND_DOMAIN=vialchemlabs.net

# =============================================================================
# Supabase (database)
# =============================================================================
# Provision via: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_SUPABASE=true

# Apply the new migration before launch:
#   supabase migration up 20260520000001_append_only_triggers_and_indexes
# Verify:
#   psql <conn> -c "\d+ audit_log"  # confirm trigger reject_audit_mutation present
#   psql <conn> -c "select default_for_brand from lab_partners where slug='janoshik'"  # should be false

# =============================================================================
# Plaid (ACH rail)
# =============================================================================
# Provision via: https://dashboard.plaid.com (production application)
# Iron Law 2.30 — webhook signature spec: PLAID_VERIFICATION_MODE='jwks' is
# the v5 LOCKED default. HMAC mode retained as legacy via 'hmac'.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_PRODUCTS=auth,transactions,transfer
PLAID_COUNTRY_CODES=US
PLAID_VERIFICATION_MODE=jwks
PLAID_WEBHOOK_VERIFICATION_KEY=  # only used in hmac mode legacy

# =============================================================================
# BTCPay (crypto rail)
# =============================================================================
# Provision via: operator self-hosted BTCPay store
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_SERVER_URL=  # alias used by some adapter helpers

# =============================================================================
# Bitcoin direct fallback (when BTCPay unreachable)
# =============================================================================
BITCOIN_DIRECT_RECEIVE_ADDRESS=
BITCOIN_DIRECT_SUPPORT_EMAIL=
BITCOIN_DIRECT_CONFIRMATIONS_REQUIRED=3
BITCOIN_DIRECT_RATE_BUFFER_BPS=200
BITCOIN_DIRECT_SIGNING_SECRET=

# =============================================================================
# Zelle (manual-reconciliation rail)
# =============================================================================
# Operator-provisioned bank credentials; Zelle is buyer-attested + manual
# reconciliation per Iron Law 2.30 amendment in LOCKED_OVERRIDE.
ENABLE_ZELLE=true
ZELLE_RECIPIENT_NAME=
ZELLE_HANDLE=
ZELLE_EMAIL=
ZELLE_PHONE=
ZELLE_QR_IMAGE_URL=
ZELLE_PAYMENT_NOTE_PREFIX=VialChem
ZELLE_SUPPORT_EMAIL=
ZELLE_BUSINESS_NAME=VialChem Labs LLC

# =============================================================================
# WooCommerce handoff (link_money / card / apple_pay / google_pay / paypal)
# =============================================================================
# Provision via: operator self-hosted WooCommerce on shop.vialchemlabs.net subdomain
WOOCOMMERCE_API_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_PREVIEW_URL=  # local-only

# =============================================================================
# Resend (transactional email)
# =============================================================================
# Provision via: https://resend.com/api-keys
# Domain verification: vialchemlabs.net DMARC p=reject; SPF + DKIM aligned
RESEND_API_KEY=
ORDER_EMAIL_FROM=research@vialchemlabs.net
ORDER_STAFF_EMAILS=ops@vialchemlabs.net
REQUIRE_RESEND=true

# =============================================================================
# Sentry (error monitoring)
# =============================================================================
# Provision via: https://sentry.io/settings/<org>/projects/<project>/keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production

# Iron Law 2.32 alert rule thresholds (provision in Sentry console):
#   - Error rate > 0.5% over 5min → P1
#   - Webhook sig rejection rate > 5% over 15min → P0
#   - Lighthouse Performance regression > 5 points → P1
#   - 5xx rate > 1% on any route → P0
#   - /api/access validation error > 30% over 1h → P2

# =============================================================================
# Upstash Redis (rate limiter — optional Day-1; required at ~100 RPS)
# =============================================================================
# Provision via: https://upstash.com (REST-enabled database)
# Falls back to in-memory LRU when these are unset (Day-1 acceptable).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Age-gate signing (Iron Law 2.10 + age-verification cookie)
# =============================================================================
# Generate via:
#   openssl rand -hex 32
# Length: 64 hex chars (32 bytes). MUST be set in production.
AGE_GATE_SECRET=

# =============================================================================
# LLC + legal identity
# =============================================================================
LLC_NAME=VialChem Labs LLC
LLC_JURISDICTION=Wyoming
NEXT_PUBLIC_LLC_NAME=VialChem Labs LLC
NEXT_PUBLIC_LLC_JURISDICTION=Wyoming

# =============================================================================
# Lab partner (operator decision; default lab-agnostic per LOCKED_OVERRIDE)
# =============================================================================
# To use a named partner instead, set both vars (env-driven override):
# LAB_PARTNER_NAME=
# LAB_PARTNER_PORTAL_URL=
# LAB_PARTNER_SHORT_NAME=

# =============================================================================
# Production flags
# =============================================================================
NODE_ENV=production
OPS_SIGNUP_ENABLED=false
PILOT_US_SHIPPING_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=20000

# =============================================================================
# Build-time (Vercel auto-injects; documented here for reference)
# =============================================================================
# VERCEL_GIT_COMMIT_SHA       # auto-injected by Vercel
# VERCEL_GIT_REPO_SLUG        # auto-injected
# VERCEL_ENV                  # auto-injected (production / preview / development)
NEXT_PUBLIC_PACKAGE_VERSION=v5.0.0  # canary attribution per audit L13

# =============================================================================
# Operator pre-launch checklist (Appendix Q from v5 spec)
# =============================================================================
# [ ] Vercel project on Pro plan or higher
# [ ] Supabase project on Pro tier
# [ ] Resend domain verified + DMARC p=reject
# [ ] BTCPay store provisioned + tested
# [ ] Plaid production env credentials provisioned
# [ ] Sentry alert thresholds wired (see above)
# [ ] CDN cache rules verified (vercel.json)
# [ ] Database connection pooling configured (Supabase pgbouncer)
# [ ] Rate limiters active on every POST route (default in-memory; production
#     Upstash recommended)
# [ ] Cookie consent confirmed; analytics opt-in respected
# [ ] Sitemap submitted to Google Search Console + Bing Webmaster
# [ ] OG image tested via Twitter Card Validator + LinkedIn Inspector
# [ ] Error pages (404, 500) brand-consistent
# [ ] Apply migration 20260520000001_append_only_triggers_and_indexes
# [ ] Run scripts/setup-branch-protection.sh AFTER first PR's CI run
# [ ] First-buyer test on BTCPay + Plaid rails (HIL GATE 2)

# =============================================================================
# DO NOT COMMIT THIS FILE WITH VALUES
# =============================================================================
# This template lives at .env.production.template (committed).
# Operator provisions values in:
#   - Vercel project env-vars dashboard (preferred)
#   - OR local .env.production (gitignored via .gitignore .env*)
