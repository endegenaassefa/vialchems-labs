# vialchemlabs — Environment Configuration Template
# Copy this file to .env (do NOT commit .env). Fill in your actual values.
# Phase numbers refer to the 15-phase build defined in
# /root/peptide-launch-bundle/corpus/SUPER_PROMPT_v3_2026-05-08.md

# ============================================================
# Site basics (Phase 0, Phase 4)
# ============================================================
SITE_URL=https://vialchemlabs.net
NEXT_PUBLIC_SITE_URL=https://vialchemlabs.net
BRAND_NAME=vialchemlabs
BRAND_DOMAIN=vialchemlabs.net
NEXT_PUBLIC_SITE_NAME=vialchemlabs

# ============================================================
# Supabase (Phase 3) — auth + database
# Create new project at https://supabase.com
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
REQUIRE_SUPABASE=true
ALLOW_SUPABASE_OPTIONAL_IN_PRODUCTION=false

# Server-signed age gate cookie. Generate a long random value for production.
AGE_GATE_SECRET=

# ============================================================
# Payments — Zelle can run without BTCPay while Bitcoin checkout is paused.
# ============================================================
PAYMENT_PROVIDER=zelle
ALLOW_STUB_PAYMENTS_IN_PRODUCTION=false

# BTCPay Server direct Bitcoin checkout on vialchemlabs.net.
# BTCPAY_URL is retained as a legacy alias; prefer BTCPAY_SERVER_URL.
BTCPAY_SERVER_URL=https://your-btcpay-server.example.com
BTCPAY_URL=https://your-btcpay-server.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# Direct on-chain Bitcoin fallback hosted entirely on vialchemlabs.net.
# This keeps Bitcoin available if BTCPay/Voltage checkout is unreachable.
# Do not set a private key here. Use a receiving address from your own wallet.
BITCOIN_DIRECT_CHECKOUT_ENABLED=false
BITCOIN_RECEIVE_ADDRESS=
BITCOIN_DIRECT_SIGNING_SECRET=
BITCOIN_SUPPORT_EMAIL=abhinav@vialchemlabs.net
BITCOIN_CONFIRMATIONS_REQUIRED=1
BITCOIN_DIRECT_RATE_BUFFER_BPS=0
BITCOIN_RATE_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot

# Zelle manual bank-app checkout on vialchemlabs.net.
# Public Zelle defaults are built into the app from the verified bank setup:
# recipient "Vialchem Labs LLC", Zelle ID "vialchem-pay", support email
# "abhinav@vialchemlabs.net". Override only if the bank recipient changes.
ZELLE_RECIPIENT_NAME=Vialchem Labs LLC
ZELLE_HANDLE=vialchem-pay
ZELLE_EMAIL=abhinav@vialchemlabs.net
ZELLE_SUPPORT_EMAIL=abhinav@vialchemlabs.net
ZELLE_PHONE=
# Use the official downloaded bank QR image, for example /payments/zelle-qr.png
# after placing it under public/payments/zelle-qr.png.
ZELLE_QR_IMAGE_URL=/payments/zelle-qr.png
ZELLE_PAYMENT_NOTE_PREFIX=VCL
ZELLE_CHECKOUT_SIGNING_SECRET=
NEXT_PUBLIC_ENABLE_BITCOIN_CHECKOUT=false
# Keep Woo-style checkout rails visibly disabled until they are contractually
# and technically ready.
ENABLE_WOO_CHECKOUT_METHODS=false

# Plaid ACH (https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions
PLAID_COUNTRY_CODES=US
# HMAC-SHA256 key over raw body in `Plaid-Verification` header (legacy).
# Phase 10.4 ships JWKS-based JWT verification structural pre-flight; full
# ES256 signature verification activates in Phase 11. Set
# PLAID_VERIFICATION_MODE=jwks once operator confirms production routing.
PLAID_WEBHOOK_VERIFICATION_KEY=
PLAID_VERIFICATION_MODE=hmac

# Phase 2 cards (NOT activated until Day 90+)
ENABLE_CARDS_PHASE_2=false

# WooCommerce checkout handoff (shop.vialchemlabs.net)
WOOCOMMERCE_STORE_URL=https://shop.vialchemlabs.net
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
CHECKOUT_ALLOWED_ORIGINS=
# Local preview only. Never enable in production.
ALLOW_WOO_MOCK_HANDOFF_IN_DEVELOPMENT=false
WOO_MOCK_CHECKOUT_URL=http://localhost:3002
LINK_MONEY_API_KEY=
STRIPE_PLACEHOLDER_ENABLED=false
PAYPAL_PLACEHOLDER_ENABLED=false

# ============================================================
# Email (Resend; Phase 6, Phase 10)
# Get API key from https://resend.com
# ============================================================
RESEND_API_KEY=
ORDER_EMAIL_FROM=research@vialchemlabs.net
ORDER_STAFF_EMAILS=ops@vialchemlabs.net
REQUIRE_RESEND=true
ALLOW_RESEND_OPTIONAL_IN_PRODUCTION=false

# ============================================================
# Sentry monitoring (Phase 3, Phase 15)
# Create project at https://sentry.io
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================
# Lab partner (Phase 7) — Janoshik default
# ============================================================
LAB_PARTNER_NAME=Janoshik Analytical
LAB_PARTNER_PORTAL_URL=https://janoshik.com

# ============================================================
# Shipping (Phase 7, Phase 10)
# ============================================================
PILOT_US_SHIPPING_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=20000

# ============================================================
# LLC + legal entity (operator confirms post-formation)
# Wyoming / Delaware / Nevada recommended
# ============================================================
LLC_NAME=vialchemlabs LLC
LLC_JURISDICTION=Wyoming
NEXT_PUBLIC_LLC_NAME=vialchemlabs LLC
NEXT_PUBLIC_LLC_JURISDICTION=Wyoming
LLC_REGISTERED_AGENT=
LLC_PRINCIPAL_ADDRESS=

# ============================================================
# Cookie consent (Phase 10.6)
# ============================================================
# Day-1 default = self-hosted (components/CookieConsent.tsx + lib/consent-store.ts).
# Alternatives: 'osano' | 'cookiebot' | 'onetrust' (require API key).
COOKIE_CONSENT_PROVIDER=self-hosted
COOKIE_CONSENT_PROVIDER_API_KEY=

# ============================================================
# Rate limiting (Iron Law 2.34)
# ============================================================
# Tests + local dev: SKIP_RATE_LIMIT=true bypasses the gate entirely.
# Production MUST leave this unset/false; a module-load Sentry alert
# fires if NODE_ENV=production AND SKIP_RATE_LIMIT=true.
SKIP_RATE_LIMIT=

# Per-bucket key cap for the in-memory LRU. Raise if you expect >10k
# unique IPs per hour per route on a single Vercel instance. Ignored
# when UPSTASH_REDIS_REST_URL is set (Upstash handles eviction).
RATE_LIMIT_MAX_KEYS=10000

# ============================================================
# Upstash Redis — rate limiter cross-instance coordination (Iron Law 2.34)
# Optional Day-1 (in-memory LRU is the default); recommended by ~100 RPS.
# Provision a REST-enabled database via https://upstash.com/. When BOTH
# vars below are set, lib/rate-limit.ts dispatches through
# @upstash/ratelimit (slidingWindow per route) and `getRateLimitAdapter()`
# reports "upstash". Upstash failures (timeouts, 5xx) fail OPEN: the
# request falls back to the in-memory adapter and a
# `rate_limit.upstash_fallback` Sentry warning is emitted.
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Misc
# ============================================================
NODE_ENV=development
OPS_SIGNUP_ENABLED=false
DEBUG_BUILD=false

# ============================================================
# Vercel (Phase 14 — populated when `vercel link` runs)
# ============================================================
# Local deployment automation only. Do not expose these as NEXT_PUBLIC_* values.
# VERCEL_TOKEN comes from Vercel Account Settings -> Tokens.
# VERCEL_ORG_ID and VERCEL_PROJECT_ID come from .vercel/project.json after `vercel link`.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
