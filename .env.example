# vialchemlabs — Environment Configuration Template
# Copy this file to .env (do NOT commit .env). Fill in your actual values.
# Phase numbers refer to the 15-phase build defined in
# /root/peptide-launch-bundle/corpus/SUPER_PROMPT_v3_2026-05-08.md

# ============================================================
# Site basics (Phase 0, Phase 4)
# ============================================================
SITE_URL=https://vialchemlabs.net
NEXT_PUBLIC_SITE_URL=https://vialchemlabs.net
BRAND_NAME=vialchemlabs
BRAND_DOMAIN=vialchemlabs.net
NEXT_PUBLIC_SITE_NAME=vialchemlabs

# ============================================================
# Supabase (Phase 3) — auth + database
# Create new project at https://supabase.com
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
REQUIRE_SUPABASE=true
ALLOW_SUPABASE_OPTIONAL_IN_PRODUCTION=false

# Server-signed age gate cookie. Generate a long random value for production.
AGE_GATE_SECRET=

# ============================================================
# Payments (Phase 9) — production must use btcpay. Stub is local/test only.
# ============================================================
PAYMENT_PROVIDER=btcpay
ALLOW_STUB_PAYMENTS_IN_PRODUCTION=false

# BTCPay Server (self-hosted; ops provisions per scripts/btcpay-setup.sh)
BTCPAY_URL=https://your-btcpay-server.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# Plaid ACH (https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions
PLAID_COUNTRY_CODES=US
# HMAC-SHA256 key over raw body in `Plaid-Verification` header (legacy).
# Phase 10.4 ships JWKS-based JWT verification structural pre-flight; full
# ES256 signature verification activates in Phase 11. Set
# PLAID_VERIFICATION_MODE=jwks once operator confirms production routing.
PLAID_WEBHOOK_VERIFICATION_KEY=
PLAID_VERIFICATION_MODE=hmac

# Zelle manual bank-app payment rail.
# Do not enable until the bank confirms this exact business/category is allowed.
ENABLE_ZELLE=false
NEXT_PUBLIC_ENABLE_ZELLE=false
ZELLE_BUSINESS_NAME=
ZELLE_HANDLE=
ZELLE_BANK_NAME=
ZELLE_TERMS_APPROVED_AT=
ZELLE_QR_IMAGE_URL=

# Phase 2 cards (NOT activated until Day 90+)
ENABLE_CARDS_PHASE_2=false

# ============================================================
# Email (Resend; Phase 6, Phase 10)
# Get API key from https://resend.com
# ============================================================
RESEND_API_KEY=
ORDER_EMAIL_FROM=research@vialchemlabs.net
ORDER_STAFF_EMAILS=ops@vialchemlabs.net
REQUIRE_RESEND=true
ALLOW_RESEND_OPTIONAL_IN_PRODUCTION=false

# ============================================================
# Sentry monitoring (Phase 3, Phase 15)
# Create project at https://sentry.io
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================
# Lab partner (Phase 7) — Janoshik default
# ============================================================
LAB_PARTNER_NAME=Janoshik Analytical
LAB_PARTNER_PORTAL_URL=https://janoshik.com

# ============================================================
# Shipping (Phase 7, Phase 10)
# ============================================================
PILOT_US_SHIPPING_CENTS=1500
FREE_SHIPPING_THRESHOLD_CENTS=20000

# ============================================================
# LLC + legal entity (operator confirms post-formation)
# Wyoming / Delaware / Nevada recommended
# ============================================================
LLC_NAME=vialchemlabs LLC
LLC_JURISDICTION=Wyoming
NEXT_PUBLIC_LLC_NAME=vialchemlabs LLC
NEXT_PUBLIC_LLC_JURISDICTION=Wyoming
LLC_REGISTERED_AGENT=
LLC_PRINCIPAL_ADDRESS=

# ============================================================
# Cookie consent (Phase 10.6)
# ============================================================
# Day-1 default = self-hosted (components/CookieConsent.tsx + lib/consent-store.ts).
# Alternatives: 'osano' | 'cookiebot' | 'onetrust' (require API key).
COOKIE_CONSENT_PROVIDER=self-hosted
COOKIE_CONSENT_PROVIDER_API_KEY=

# ============================================================
# Phase A — Order Admin (CEO plan 2026-05-13)
# ============================================================
# Shared bearer token for /api/ops/* endpoints + the /ops admin UI. Generate
# with: openssl rand -hex 32. Staff paste this into the admin login screen
# (stored in localStorage). Rotate by changing this value + all staff re-login.
OPS_API_TOKEN=

# Shippo (https://goshippo.com) — shipping label provider.
# Test keys start with shippo_test_; live keys start with shippo_live_.
# Webhook secret comes from Shippo dashboard > Webhooks > "Secret".
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_SECRET=
# Optional: force test mode even with a live-looking key.
ENABLE_SHIPPO_TEST_MODE=false

# Order admin email kill-switch (D18 guardrail). When an order has
# is_test=true, shipment + refund emails are diverted here instead of going
# to the real customer. Falls back to ORDER_EMAIL_FROM if unset. Use a
# real inbox you can monitor (e.g. ops+test@vialchemlabs.net).
ORDER_TEST_INBOX=

# Where the "I've sent the payment" notification (Zelle manual-payment
# claims) is emailed so ops has a work queue. Falls back to
# ORDER_TEST_INBOX, then ORDER_EMAIL_FROM, if unset.
OPS_NOTIFICATION_INBOX=

# Ship-from address — where you ship orders FROM (Shippo needs this to
# compute rates and print return addresses on labels). Required when
# using the "Buy Shippo label" button.
SHIPPING_FROM_NAME=
SHIPPING_FROM_STREET1=
SHIPPING_FROM_STREET2=
SHIPPING_FROM_CITY=
SHIPPING_FROM_STATE=
SHIPPING_FROM_ZIP=
SHIPPING_FROM_COUNTRY=US
SHIPPING_FROM_PHONE=
SHIPPING_FROM_EMAIL=

# Default parcel dimensions (one-vial padded mailer). Override per-order
# in a follow-up phase when you start shipping larger orders.
SHIPPING_DEFAULT_LENGTH_IN=8
SHIPPING_DEFAULT_WIDTH_IN=6
SHIPPING_DEFAULT_HEIGHT_IN=2
SHIPPING_DEFAULT_WEIGHT_OZ=8

# ============================================================
# Misc
# ============================================================
NODE_ENV=development
OPS_SIGNUP_ENABLED=false
OPS_API_TOKEN=
DEBUG_BUILD=false

# ============================================================
# Vercel (Phase 14 — populated when `vercel link` runs)
# ============================================================
# Local deployment automation only. Do not expose these as NEXT_PUBLIC_* values.
# VERCEL_TOKEN comes from Vercel Account Settings -> Tokens.
# VERCEL_ORG_ID and VERCEL_PROJECT_ID come from .vercel/project.json after `vercel link`.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
